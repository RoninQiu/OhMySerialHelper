{
  "productName": "OhMySerial",
  "version": "1.2.0",
  "identifier": "com.ohmyserial.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite --port 1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OhMySerial - 串口调试助手",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  }
}
